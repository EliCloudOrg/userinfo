# EliCloud 用户资料服务 —— 环境变量示例
#
# 本地开发：复制成 .env.local（不要提交），docker compose up -d 即可。
# 生产部署：这些值放服务器 /srv/userinfo/app.env（600，deploy:deploy），
#          由 deploy/deploy.sh 读出后写进 docker 可见项目目录的 .env。
#          ⚠️ 绝不要提交到 Git、不要写进镜像层、不要打印到日志。

# ---- SSO 接入（必须与 SSO 的 PUBLIC_BASE_URL 逐字一致）----
SSO_ISSUER=https://146.56.237.33/auth
SSO_JWKS_URL=https://146.56.237.33/auth/.well-known/jwks.json
JWT_AUDIENCE=elicloud-services
# 令牌必须含这些 scope；配成空串 = 关闭对应校验（只允许本地调试）
REQUIRED_READ_SCOPE=userinfo:read
REQUIRED_WRITE_SCOPE=userinfo:write
REQUIRED_FILE_READ_SCOPE=files:read
REQUIRED_FILE_WRITE_SCOPE=files:write

# ---- 元数据存储（只放文字资料和 file id，不放图片字节）----
DATABASE_URL=sqlite:////data/userinfo.db

# ---- file 服务 ----
FILE_SERVICE_BASE_URL=http://file:8000
FILE_SERVICE_TIMEOUT_SECONDS=15

# ---- 图片上限 ----
MAX_AVATAR_BYTES=5242880
MAX_BANNER_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ---- 文本限制 ----
MAX_NICKNAME_CHARS=32
MAX_BIO_CHARS=500

# ---- 写操作限流（按 sub + IP）----
WRITE_ATTEMPTS_PER_WINDOW=60
IMAGE_ATTEMPTS_PER_WINDOW=20
WRITE_WINDOW_SECONDS=600

# ---- 通用 ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
